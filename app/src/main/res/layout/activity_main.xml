<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/home_flight_deck"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.02"
            android:text="JeppIran"
            android:textColor="@color/jeppiran_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_version_chip"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="V2620"
            android:textColor="@color/jeppiran_text"
            android:textSize="11sp"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.19"
            android:text="AVIATION CHARTS &amp; WEATHER"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="10.5sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCharts" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_charts" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Charts" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:visibility="gone" android:text="Approach, Departure&#10;&amp; Airport Charts" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardEnroute" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_enroute" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="En-route" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:visibility="gone" android:text="Airways, SIGMETs&#10;&amp; Navigation" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardWx" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_weather" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="WX" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:visibility="gone" android:text="METAR, TAF,&#10;Radar &amp; Forecast" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardUpdate" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_update" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Update" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:visibility="gone" android:text="Charts, NavData&#10;&amp; Weather Data" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSettings" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_settings" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Settings" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:visibility="gone" android:text="Preferences,&#10;Aircraft &amp; Units" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardInfo" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_info" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Info" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:visibility="gone" android:text="About, Support&#10;&amp; Legal" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="FOR FLIGHT PLANNING • VERIFY CURRENT DATA"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="9.5sp" />
    </LinearLayout>
</ScrollView>
