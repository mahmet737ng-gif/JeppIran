<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_flight_deck"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_strip"
            android:gravity="center_vertical"
            android:minHeight="38dp"
            android:paddingStart="13dp"
            android:paddingTop="8dp"
            android:paddingEnd="13dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="FLIGHT DECK"
                android:textColor="@color/jeppiran_accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="OFFLINE CHARTS READY"
                android:textColor="@color/jeppiran_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:contentDescription="JEPPIRAN logo"
            android:scaleType="fitCenter"
            android:src="@drawable/jeppiran_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-2dp"
            android:letterSpacing="0.14"
            android:text="JEPPIRAN"
            android:textColor="@color/jeppiran_text"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_version_chip"
            android:paddingStart="13dp"
            android:paddingTop="5dp"
            android:paddingEnd="13dp"
            android:paddingBottom="5dp"
            android:text="V2620"
            android:textColor="@color/jeppiran_text"
            android:textSize="10sp"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:letterSpacing="0.2"
            android:text="AVIATION CHARTS  •  WEATHER  •  NAVIGATION"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="9.5sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="@integer/home_column_count"
            android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCharts" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:contentDescription="Charts" android:src="@drawable/ic_home_charts" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Charts" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Approach, Departure&#10;&amp; Airport Charts" />
                    </LinearLayout>
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_accent" android:textSize="27sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardEnroute" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:contentDescription="En-route" android:src="@drawable/ic_home_enroute" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="En-route" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Airways, SIGMETs&#10;&amp; Navigation" />
                    </LinearLayout>
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_accent" android:textSize="27sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardWx" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:contentDescription="Weather" android:src="@drawable/ic_home_weather" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="WX" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="METAR, TAF,&#10;Radar &amp; Forecast" />
                    </LinearLayout>
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_accent" android:textSize="27sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardUpdate" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:contentDescription="Update" android:src="@drawable/ic_home_update" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Update" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Charts, NavData&#10;&amp; Weather Data" />
                    </LinearLayout>
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_accent" android:textSize="27sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSettings" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:contentDescription="Settings" android:src="@drawable/ic_home_settings" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Settings" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Preferences,&#10;Aircraft &amp; Units" />
                    </LinearLayout>
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_accent" android:textSize="27sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardInfo" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:contentDescription="Information" android:src="@drawable/ic_home_info" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Info" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="About, Support&#10;&amp; Legal" />
                    </LinearLayout>
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_accent" android:textSize="27sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="FOR FLIGHT PLANNING  •  VERIFY CURRENT DATA"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>