<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_flight_deck"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp">
        <!-- UTC only; Android TextClock handles updates across timezone changes. -->
        <TextClock
            android:id="@+id/homeUtcClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:timeZone="UTC"
            android:format24Hour="HH:mm'Z'  UTC"
            android:format12Hour="HH:mm'Z'  UTC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"
            android:textColor="@color/jeppiran_text_secondary" />


        <ImageView
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="JeppIran logo"
            android:scaleType="fitCenter"
            android:src="@drawable/jeppiran_brand_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-4dp"
            android:letterSpacing="0.12"
            android:text="JeppIran"
            android:textColor="@color/jeppiran_text"
            android:textSize="39sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_version_chip"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="V2620"
            android:textColor="@color/jeppiran_text"
            android:textSize="11sp"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:letterSpacing="0.19"
            android:text="AVIATION CHARTS FOR A HIGHER PERSPECTIVE"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="10.5sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/homeGrid"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCharts" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_charts" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Charts" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Approach, Departure&#10;&amp; Airport Charts" />
                    </LinearLayout>
                    <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_text" android:textSize="29sp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardEnroute" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_enroute" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Enroute" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Airways, SIGMETs&#10;&amp; Navigation" />
                    </LinearLayout>
                    <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_text" android:textSize="29sp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardWx" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_weather" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Weather" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="METAR, TAF,&#10;Radar &amp; Forecast" />
                    </LinearLayout>
                    <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_text" android:textSize="29sp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardUpdate" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_update" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Update" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Charts, NavData&#10;&amp; Weather Data" />
                    </LinearLayout>
                    <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_text" android:textSize="29sp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSettings" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_settings" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Settings" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="Preferences,&#10;Aircraft &amp; Units" />
                    </LinearLayout>
                    <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_text" android:textSize="29sp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardInfo" style="@style/JeppIranMenuCard">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                        <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_info" />
                        <TextView style="@style/JeppIranMenuTitle" android:text="Info" />
                        <TextView style="@style/JeppIranMenuSubtitle" android:text="About, Support&#10;&amp; Legal" />
                    </LinearLayout>
                    <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_round_outline" android:gravity="center" android:text="›" android:textColor="@color/jeppiran_text" android:textSize="29sp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="FOR PERSONAL USE ONLY • NOT FOR ACTUAL NAVIGATION"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="9.5sp" />
    </LinearLayout>
</ScrollView>