<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/jeppiran_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/jeppiran_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/jeppiran_card_stroke"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">
                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:contentDescription="JEPPIRAN logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_jeppiran_launcher" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="JEPPIRAN"
                        android:textColor="@color/jeppiran_text"
                        android:textSize="29sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Aviation Charts &amp; Weather"
                        android:textColor="@color/jeppiran_text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/versionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_version_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="V2620"
                        android:textColor="@color/jeppiran_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="FLIGHT DECK"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="false">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCharts" style="@style/JeppIranMenuCard">
                <LinearLayout style="@style/JeppIranMenuCardContent">
                    <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_charts" />
                    <TextView style="@style/JeppIranMenuTitle" android:text="Charts" />
                    <TextView style="@style/JeppIranMenuSubtitle" android:text="Airport plates" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardEnroute" style="@style/JeppIranMenuCard">
                <LinearLayout style="@style/JeppIranMenuCardContent">
                    <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_enroute" />
                    <TextView style="@style/JeppIranMenuTitle" android:text="En-route" />
                    <TextView style="@style/JeppIranMenuSubtitle" android:text="Future cycle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardWx" style="@style/JeppIranMenuCard">
                <LinearLayout style="@style/JeppIranMenuCardContent">
                    <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_weather" />
                    <TextView style="@style/JeppIranMenuTitle" android:text="WX" />
                    <TextView style="@style/JeppIranMenuSubtitle" android:text="METAR / TAF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardUpdate" style="@style/JeppIranMenuCard">
                <LinearLayout style="@style/JeppIranMenuCardContent">
                    <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_update" />
                    <TextView style="@style/JeppIranMenuTitle" android:text="Update" />
                    <TextView style="@style/JeppIranMenuSubtitle" android:text="Chart cycle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSettings" style="@style/JeppIranMenuCard">
                <LinearLayout style="@style/JeppIranMenuCardContent">
                    <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_settings" />
                    <TextView style="@style/JeppIranMenuTitle" android:text="Settings" />
                    <TextView style="@style/JeppIranMenuSubtitle" android:text="App &amp; simulator" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardInfo" style="@style/JeppIranMenuCard">
                <LinearLayout style="@style/JeppIranMenuCardContent">
                    <ImageView style="@style/JeppIranMenuIcon" android:src="@drawable/ic_home_info" />
                    <TextView style="@style/JeppIranMenuTitle" android:text="Info" />
                    <TextView style="@style/JeppIranMenuSubtitle" android:text="About JEPPIRAN" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="FOR FLIGHT PLANNING • VERIFY CURRENT DATA"
            android:textColor="@color/jeppiran_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
