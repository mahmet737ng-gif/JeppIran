<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:icon="@drawable/jeppiran_logo"
        android:roundIcon="@drawable/jeppiran_logo"
        android:label="JEPPIRAN"
        android:supportsRtl="true"
        android:theme="@style/Theme.JeppIran">


        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout"
            android:screenOrientation="unspecified">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <activity
            android:name=".ChartsActivity"
            android:exported="false" />


        <activity
            android:name=".AirportChartsActivity"
            android:exported="false" />


        <activity
            android:name=".PdfViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout"
            android:screenOrientation="unspecified" />


        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".SimulatorActivity"
            android:exported="false" />

        <activity
            android:name=".WxActivity"
            android:exported="false" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false" />

        <activity
            android:name=".ChangesAirportsActivity"
            android:exported="false" />

        <activity
            android:name=".ChartChangesActivity"
            android:exported="false" />

        <activity
            android:name=".ChartDiffActivity"
            android:exported="false" />

        <activity
            android:name=".EnrouteActivity"
            android:exported="false" />

        <activity
            android:name=".InfoActivity"
            android:exported="false" />


    </application>

</manifest>
